# Remux gateway that Next rewrites /v1 → (must be reachable from the Next.js process)
# Default is fine when Next and `hevc-player gateway` run on the same host.
HEVC_GATEWAY_URL=http://127.0.0.1:3002

# Port the gateway listens on (must match HEVC_GATEWAY_URL)
HEVC_GATEWAY_PORT=3002

# Next.js bind
PORT=3000
HOSTNAME=0.0.0.0

# Exact URL users type in the browser (no trailing slash). Required when not on localhost.
# Example on a server: http://169.58.70.166:3000
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Extra browser origins allowed by the gateway (comma-separated).
# PUBLIC_ORIGIN is merged in automatically by scripts/dev.mjs.
GATEWAY_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Keep accepting any loopback Origin (Vite/Next port hops). Set false in locked-down prod.
ALLOW_LOOPBACK_ORIGINS=true

# Gateway soft caps (optional). Not RTSP/MediaMTX limits — package safeguards only.
# STREAM_MAX_CONNECTIONS=64   # concurrent HTTP viewers
# STREAM_MAX_SOURCES=64       # unique camera URLs (1 FFmpeg each)
